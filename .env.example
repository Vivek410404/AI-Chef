# Storage and Persistence
STORAGE_MODE=postgres
REQUIRE_DATABASE=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rasoi_iq?schema=public"

# Database configuration (Local PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rasoi_iq
POSTGRES_PORT=5432

# Backend API Configuration
PORT=4000
API_URL=http://localhost:4000
JWT_SECRET=your_secure_random_jwt_secret_min_32_characters_here_2026
ADMIN_DEMO_SECRET=your_admin_bootstrap_secret_2026

# Production Security & Authentication Modes
NODE_ENV=development
ALLOW_DEMO_AUTH=false

# Transactional Email (SMTP Production Transport)
# Leave blank for Development In-Memory Inbox (GET /api/dev/emails)
SMTP_HOST= smtp.gmail.com
SMTP_PORT=587
SMTP_USER= 
SMTP_PASS=
SMTP_FROM="RasoiIQ <notifications@rasoiiq.in>"

# AI Configuration (Free Tier Google Gemini API)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=""

# Customer Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
PORT_WEB=3000
