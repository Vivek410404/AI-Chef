{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["es2021", "dom"],
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@rasoi/database": ["packages/database/src"],
      "@rasoi/database/*": ["packages/database/src/*"],
      "@rasoi/grocery-engine": ["packages/grocery-engine/src"],
      "@rasoi/grocery-engine/*": ["packages/grocery-engine/src/*"],
      "@rasoi/shared-types": ["packages/shared-types/src"],
      "@rasoi/shared-types/*": ["packages/shared-types/src/*"],
      "@rasoi/validation": ["packages/validation/src"],
      "@rasoi/validation/*": ["packages/validation/src/*"],
      "@/*": ["apps/customer-web/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "services/*/src/**/*",
    "apps/*/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/.next"
  ]
}
