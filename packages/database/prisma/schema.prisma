datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  RETAILER
  ADMIN
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum HouseholdRole {
  OWNER
  MEMBER
  COOK
}

enum RetailerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SpiceTolerance {
  MILD
  MEDIUM
  SPICY
  DESI_TEEKHA
}

enum DietaryType {
  VEGETARIAN
  NON_VEGETARIAN
  JAIN
  VEGAN
  EGGETARIAN
}

model User {
  id               String                   @id @default(cuid())
  email            String                   @unique
  normalizedEmail  String                   @default("")
  passwordHash     String
  fullName         String
  phoneNumber      String?
  role             Role                     @default(CUSTOMER)
  status           UserStatus               @default(ACTIVE)
  suspensionReason String?
  suspendedAt      DateTime?
  suspendedBy      String?
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  households       Household[]
  householdMembers HouseholdMember[]
  sessions         Session[]
  refreshSessions  RefreshSession[]
  emailTokens      EmailVerificationToken[]
  resetTokens      PasswordResetToken[]
  addresses        Address[]
  orders           Order[]
  feedbacks        Feedback[]
  retailerApps     RetailerApplication[]
  auditLogs        AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RefreshSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  tokenFamilyId String
  deviceName    String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  @@index([userId])
  @@index([tokenFamilyId])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model RevokedToken {
  id        String   @id @default(cuid())
  token     String   @unique
  reason    String?  @default("LOGOUT")
  revokedAt DateTime @default(now())
  expiresAt DateTime
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String   // "Home", "Office", "Parents"
  flatBuilding String
  street       String
  landmark     String?
  city         String
  state        String
  pincode      String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
}

model Household {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  country           String                @default("India")
  state             String                @default("Gujarat")
  city              String                @default("Ahmedabad")
  locality          String?
  size              Int                   @default(4)
  dietaryPreference DietaryType           @default(VEGETARIAN)
  cuisinePreference String                @default("ALL_INDIAN")
  spiceTolerance    SpiceTolerance        @default(MEDIUM)
  weeklyBudgetInr   Float                 @default(3000)
  cookingFrequency  String                @default("Daily Fresh")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  members           HouseholdMember[]
  pantryItems       PantryItem[]
  mealPlans         MealPlan[]
  baskets           Basket[]
  invitations       HouseholdInvitation[]
}

model HouseholdMember {
  id                  String        @id @default(cuid())
  householdId         String
  household           Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                String
  ageGroup            String        @default("adult")
  dietaryPreference   DietaryType   @default(VEGETARIAN)
  allergies           String[]      @default([])
  dislikedIngredients String[]      @default([])
  role                HouseholdRole @default(MEMBER)
  status              String        @default("ACTIVE")
  joinedAt            DateTime      @default(now())
  createdAt           DateTime      @default(now())

  @@index([householdId])
  @@index([userId])
}

model HouseholdInvitation {
  id              String        @id @default(cuid())
  householdId     String
  household       Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedEmail    String
  invitedByUserId String
  tokenHash       String        @unique
  role            HouseholdRole @default(MEMBER)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([householdId])
  @@index([invitedEmail])
}

model RetailerApplication {
  id                 String                    @id @default(cuid())
  userId             String
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  contactInformation Json
  applicationStatus  RetailerApplicationStatus @default(PENDING)
  submittedAt        DateTime                  @default(now())
  reviewedAt         DateTime?
  reviewedBy         String?
  rejectionReason    String?

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Ingredient {
  id                String             @id @default(cuid())
  name              String             @unique
  hindiName         String?
  category          String
  standardUnit      String
  shelfLifeDays     Int?
  isJainPermissible Boolean            @default(true)
  recipeIngredients RecipeIngredient[]
  pantryItems       PantryItem[]
  productVariants   ProductVariant[]
}

model Recipe {
  id                   String             @id @default(cuid())
  title                String
  slug                 String             @unique
  description          String
  cuisine              String
  dietaryTags          String[]
  mealTypes            String[]
  prepTimeMinutes      Int
  cookTimeMinutes      Int
  defaultServings      Int                @default(4)
  difficulty           String             @default("Medium")
  caloriesPerServing   Float
  proteinGrams         Float
  carbsGrams           Float
  fatGrams             Float
  fiberGrams           Float
  imageUrl             String
  estimatedCostInr     Float
  isJainFriendly       Boolean            @default(false)
  jainAlternativeNotes String?
  rating               Float              @default(4.8)
  ratingCount          Int                @default(120)
  isArchived           Boolean            @default(false)
  archivedAt           DateTime?
  archivedBy           String?
  createdAt            DateTime           @default(now())
  ingredients          RecipeIngredient[]
  steps                RecipeStep[]
  mealPlanItems        MealPlanItem[]
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Float
  unit         String
  notes        String?
}

model RecipeStep {
  id              String   @id @default(cuid())
  recipeId        String
  recipe          Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stepNumber      Int
  instruction     String
  tip             String?
  durationMinutes Int?
}

model MealPlan {
  id            String         @id @default(cuid())
  householdId   String
  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  weekStartDate DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         MealPlanItem[]
}

model MealPlanItem {
  id           String   @id @default(cuid())
  mealPlanId   String
  mealPlan     MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dayOfWeek    String   // monday, tuesday, etc.
  mealCategory String   // breakfast, lunch, dinner, snack
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id])
  servings     Int      @default(4)
  notes        String?
}

model PantryItem {
  id                String     @id @default(cuid())
  householdId       String
  household         Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredientId      String
  ingredient        Ingredient @relation(fields: [ingredientId], references: [id])
  currentQuantity   Float
  unit              String
  isLowStock        Boolean    @default(false)
  lowStockThreshold Float?
  updatedAt         DateTime   @updatedAt
}

model Retailer {
  id                       String   @id @default(cuid())
  name                     String   @unique
  slug                     String   @unique
  logoUrl                  String
  deliveryTimeEstimate     String
  deliveryFeeInr           Float    @default(29)
  freeDeliveryThresholdInr Float    @default(500)
  minOrderValueInr         Float    @default(99)
  rating                   Float    @default(4.7)
  status                   String   @default("ACTIVE")
  suspendedReason          String?
  suspendedAt              DateTime?
  stores                   Store[]
  baskets                  Basket[]
}

model Store {
  id            String         @id @default(cuid())
  retailerId    String
  retailer      Retailer       @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  name          String
  city          String
  pincode       String
  storeProducts StoreProduct[]
}

model Product {
  id           String           @id @default(cuid())
  slug         String?          @unique
  brand        String
  title        String
  category     String
  imageUrl     String
  description  String?
  tags         String[]         @default([])
  status       String           @default("ACTIVE") // ACTIVE, OUT_OF_STOCK, DISCONTINUED
  isSampleData Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  variants     ProductVariant[]

  @@index([category])
  @@index([brand])
  @@index([status])
}

model ProductVariant {
  id              String         @id @default(cuid())
  productId       String
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId    String?        // Decoupled link to culinary ingredient (optional for general essentials)
  ingredient      Ingredient?    @relation(fields: [ingredientId], references: [id])
  sku             String         @unique
  brand           String
  title           String
  packQuantity    Float
  packUnit        String
  mrpInr          Float
  sellingPriceInr Float
  imageUrl        String
  inStock         Boolean        @default(true)
  storeProducts   StoreProduct[]
  basketItems     BasketItem[]
  orderItems      OrderItem[]

  @@index([productId])
  @@index([sku])
}

model StoreProduct {
  id               String         @id @default(cuid())
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  inStock          Boolean        @default(true)
  stockCount       Int            @default(50)
  localPriceInr    Float

  @@unique([storeId, productVariantId])
  @@index([storeId])
  @@index([productVariantId])
}

model Basket {
  id                 String       @id @default(cuid())
  householdId        String
  household          Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  selectedRetailerId String
  retailer           Retailer     @relation(fields: [selectedRetailerId], references: [id])
  subtotalInr        Float        @default(0)
  deliveryFeeInr     Float        @default(0)
  totalInr           Float        @default(0)
  items              BasketItem[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model BasketItem {
  id                    String         @id @default(cuid())
  basketId              String
  basket                Basket         @relation(fields: [basketId], references: [id], onDelete: Cascade)
  productVariantId      String
  productVariant        ProductVariant @relation(fields: [productVariantId], references: [id])
  quantityPacks         Int            @default(1)
  isSelectedForPurchase Boolean        @default(true)
  availableAtHome       Boolean        @default(false)
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  retailerName    String
  status          String      @default("PLACED") // PLACED, PACKED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  totalAmountInr  Float
  deliveryFeeInr  Float
  deliveryAddress   String
  isDemoOrder       Boolean     @default(true)
  substitutionNotes String?
  fulfillmentNotes  String?
  statusReason      String?
  updatedBy         String?
  createdAt         DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payment         Payment?
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  productName      String?
  brand            String?
  packSize         String?
  quantityPacks    Int
  unitPriceInr     Float
}

model OrderStatusHistory {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  reason     String?
  changedBy  String?
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountInr     Float
  status        String   @default("SUCCESS") // PENDING, SUCCESS, FAILED
  paymentMethod String   @default("UPI") // UPI, CARD, NETBANKING, COD
  transactionId String   @unique
  createdAt     DateTime @default(now())
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  category  String   @default("GENERAL")
  createdAt DateTime @default(now())
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
